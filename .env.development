# Local development defaults. Copied to .env by `make env`; safe to edit.
# This file holds no secrets: the database password is a throwaway used only by compose.dev.yaml.
ENVIRONMENT=development
SITE_HOST=127.0.0.1
# No TLS in development, so HSTS would be meaningless here.
HSTS_MAX_AGE_SECONDS=0
PUBLIC_BASE_URL=http://127.0.0.1:8000
CONTACT_EMAIL=operator@example.org
DATABASE_URL=postgresql+psycopg://billwatcher:billwatcher@127.0.0.1:55432/billwatcher
BLOB_STORAGE_ROOT=var/blobs
# Switch to s3 to exercise the VersityGW path locally (`make db-up` starts one).
BLOB_STORAGE_BACKEND=filesystem
S3_ENDPOINT_URL=http://127.0.0.1:7070
S3_ACCESS_KEY_ID=billwatcher
S3_SECRET_ACCESS_KEY=billwatcher-secret
# Gated on the rights review (A14 / ADR-004).
SERVE_ARCHIVED_DOCUMENTS=false

# Live crawling stays off. `make seed` loads committed fixtures instead.
SCRAPE_ENABLED=false
# Parliament serves an incomplete certificate chain and publishes no robots.txt; both need an
# explicit, recorded decision before a crawl can run. See docs/upstream.md.
UPSTREAM_CA_BUNDLE=
ROBOTS_MISSING_POLICY=refuse

# Release 3 features are off and need an explicit model decision to enable.
SEMANTIC_SEARCH_ENABLED=false
RAG_ENABLED=false
