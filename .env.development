# Local development defaults. Copied to .env by `make env`; safe to edit.
# This file holds no secrets: the database password is a throwaway used only by compose.dev.yaml.
ENVIRONMENT=development
SITE_HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8000
CONTACT_EMAIL=operator@example.org
DATABASE_URL=postgresql+psycopg://billwatcher:billwatcher@127.0.0.1:55432/billwatcher
BLOB_STORAGE_ROOT=var/blobs

# Live crawling stays off. `make seed` loads committed fixtures instead.
SCRAPE_ENABLED=false

# Release 3 features are off and need an explicit model decision to enable.
SEMANTIC_SEARCH_ENABLED=false
RAG_ENABLED=false
