# Local development defaults. Copied to .env by `make env`; safe to edit.
# This file holds no secrets: the database password is a throwaway used only by compose.dev.yaml.
ENVIRONMENT=development
SITE_HOST=127.0.0.1
# No TLS in development, so HSTS would be meaningless here.
HSTS_MAX_AGE_SECONDS=0
PUBLIC_BASE_URL=http://127.0.0.1:8000
CONTACT_EMAIL=operator@example.org
DATABASE_URL=postgresql+psycopg://billwatcher:billwatcher@127.0.0.1:55432/billwatcher
BLOB_STORAGE_ROOT=var/blobs
# The human-legible audit tree (HANDOFF 27): a derived, rebuildable projection, not backed up.
# Belongs to the Postgres-backed pipeline, currently dormant.
AUDIT_TREE_ROOT=data
# The file-first pipeline's own state (billwatcher.pipeline) — no database, no object store.
PIPELINE_DATA_ROOT=pipeline-data
# The pipeline's Akoma Ntoso conversion step reads markdown structure with the help of a vLLM
# endpoint (HANDOFF 28); off by default. Set these to exercise it locally, e.g. against
# https://llm.loqasi.io/v1.
AKN_LLM_ENABLED=false
AKN_LLM_BASE_URL=
AKN_LLM_MODEL_ID=
# Switch to s3 to exercise the VersityGW path locally (`make db-up` starts one).
BLOB_STORAGE_BACKEND=filesystem
S3_ENDPOINT_URL=http://127.0.0.1:7070
S3_ACCESS_KEY_ID=billwatcher
S3_SECRET_ACCESS_KEY=billwatcher-secret
# Gated on the rights review (A14 / ADR-004).
SERVE_ARCHIVED_DOCUMENTS=false
# The file-first pipeline's legislation corpus (ADR-018). Flip this to true to browse it locally;
# production additionally requires LEGISLATION_CORPUS_RIGHTS_CONFIRMED, which is deliberately not
# a local setting — asserting a rights review is not something a development default can do.
SERVE_LEGISLATION_CORPUS=false
# metadata | full. `metadata` publishes structure and headings but none of the document's body
# text; `full` adds the text. Development is ungated either way, so this is the switch for seeing
# what each mode actually emits.
LEGISLATION_PUBLICATION_MODE=metadata
# Gate P1's text-coverage threshold. Lower it to inspect a reading the gate rejects; the rejected
# XML is written either way, so prefer reading that to loosening the gate.
AKN_GATE_MIN_TEXT_COVERAGE=0.95

# Live crawling stays off. `make seed` loads committed fixtures instead.
SCRAPE_ENABLED=false
# Parliament serves an incomplete certificate chain and publishes no robots.txt; both need an
# explicit, recorded decision before a crawl can run. See docs/upstream.md.
UPSTREAM_CA_BUNDLE=
ROBOTS_MISSING_POLICY=refuse

# Release 3 features are off and need an explicit model decision to enable.
SEMANTIC_SEARCH_ENABLED=false
RAG_ENABLED=false

# The MinerU markdown reading (HANDOFF 27.7) is off by default; set MINERU_ENABLED=true and
# MINERU_BASE_URL to exercise it locally, e.g. https://mineru.loqasi.io.
MINERU_ENABLED=false
MINERU_BASE_URL=
