ENVIRONMENT=production
SITE_HOST=bills.example.org
DATABASE_URL=postgresql+psycopg://billwatcher:CHANGE_ME@db:5432/billwatcher
POSTGRES_DB=billwatcher
POSTGRES_USER=billwatcher
POSTGRES_PASSWORD=CHANGE_ME
PUBLIC_BASE_URL=https://bills.example.org
CONTACT_EMAIL=operator@example.org
BLOB_STORAGE_ROOT=/var/lib/billwatcher/blobs
SCRAPE_ENABLED=false
SCRAPE_INTERVAL_HOURS=12
SCRAPE_DELAY_SECONDS=2
SCRAPE_CONCURRENCY=1
SCRAPE_MAX_REQUESTS_PER_RUN=2000
SCRAPE_MAX_BYTES_PER_RUN=1073741824
SCRAPE_MAX_DURATION_SECONDS=3600
SCRAPE_MAX_NEW_DOCUMENTS=500
DOCUMENT_MAX_BYTES=104857600

# Upstream serves an incomplete certificate chain (see docs/upstream.md). Point this at a bundle
# containing the missing intermediate. TLS verification is always on; there is no setting that
# turns it off.
UPSTREAM_CA_BUNDLE=

# refuse | allow. The site publishes no robots.txt; `refuse` stops the crawl until that decision
# is reviewed and recorded (assumption A13).
ROBOTS_MISSING_POLICY=refuse
ABSENCE_STREAK_ALERT=3
COUNT_DROP_ABORT_FRACTION=0.30
FETCH_ATTEMPT_RETENTION_DAYS=180

# Release 3. Both features are off by default and the site is fully usable without them.
# No production embedding model has been selected yet (ADR-008): naming one here is a decision
# that must be recorded, and its dimension must match the schema width (1024).
SEMANTIC_SEARCH_ENABLED=false
EMBEDDING_PROVIDER=
EMBEDDING_MODEL_ID=
SEMANTIC_CANDIDATES=50
HYBRID_RRF_K=60
QUERY_EMBEDDING_CACHE_SIZE=256

# RAG additionally requires semantic search, a recorded provider decision (ADR-009), and the
# optional 'rag' dependency group.
RAG_ENABLED=false
RAG_PROVIDER=
RAG_MODEL_ID=
RAG_MAX_CONTEXT_CHUNKS=8
RAG_MAX_QUESTION_CHARS=500
RAG_MIN_RETRIEVAL_SCORE=0.05
RAG_TIMEOUT_SECONDS=30
ANTHROPIC_API_KEY=
