# BillWatcherNext configuration. Copy to `.env` and edit; every value below is the default.
#
# The pipeline runs offline apart from `make download`, so most of what follows is about two
# things: how hard to lean on Parliament's server, and what may be published.

ENVIRONMENT=development

# Named in the crawler's User-Agent so Parliament can reach a person about a request. Production
# refuses to start on the placeholder.
CONTACT_EMAIL=operator@example.org

# --- where things live -------------------------------------------------------------------------
# The corpus: listings, bills, PDFs, markdown, structures, provenance, manifests. This *is* the
# record, not a projection of a database, and it is never committed.
CORPUS_ROOT=corpus
# The published tree GitHub Pages serves from this repository. Two writers share it: `make publish`
# owns the dataset, `make site` owns the compiled frontend. Committed.
SITE_ROOT=docs

# --- what the published tree says about itself -------------------------------------------------
# Where the tree is served: a bare custom domain (written into `CNAME`), or `host/path` for a
# Pages *project* repository (`cheeleong.dev/data-parlimen` — no CNAME is written, and the path
# becomes the frontend's base). Always the base of every published FRBR IRI,
# so a citation in the dataset dereferences to the page that serves it. A bare hostname: a scheme
# or trailing slash is stripped, anything else is refused at load.
SITE_PREFIX=cheeleong.dev/data-parlimen
# Which representations the dataset carries: jsonld | semantic | markdown | markdown-semantic | all
SITE_REPRESENTATIONS=markdown-semantic
# Reuse terms for this project's own output. Deliberately empty: a licence is a grant the owner
# makes, not a default a tool picks. While empty, the site says so plainly rather than implying
# terms nobody granted.
SITE_LICENCE=
SITE_LICENCE_URL=

# --- the publication boundary ------------------------------------------------------------------
# metadata = provision numbers, headings and relationships only. full = the provision text as well.
PUBLICATION_MODE=metadata
# Publishing at all. A published tree may be mirrored and cannot be withdrawn, so `make publish`
# refuses without this in every environment, development included.
PUBLISH_RIGHTS_CONFIRMED=false
# Publishing the source document's own words. The higher of the two decisions, and required both
# by PUBLICATION_MODE=full and by publishing markdown at all.
FULL_TEXT_RIGHTS_CONFIRMED=false

# --- gates -------------------------------------------------------------------------------------
# The fraction of the source markdown's distinct words that must appear somewhere in the provision
# tree read out of it, for that reading to be publishable.
STRUCTURE_GATE_MIN_TEXT_COVERAGE=0.95

# --- the one stage that touches the network ----------------------------------------------------
# `make download` also accepts --approve-live for a single run without setting this.
DOWNLOAD_ENABLED=false
# Seconds between requests. Floored at 2.0 in code as well: this is a statement about the load
# Parliament sees, not a tuning knob.
DOWNLOAD_DELAY_SECONDS=2.0
DOCUMENT_MAX_BYTES=104857600
# Set this when upstream serves an incomplete certificate chain; see documentation/upstream.md and
# `make ca-bundle`. There is deliberately no setting that disables verification.
UPSTREAM_CA_BUNDLE=
