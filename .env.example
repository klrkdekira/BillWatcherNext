ENVIRONMENT=production
# The hostname your nginx serves. TLS is terminated outside this stack (ADR-015), so nothing here
# reads this except the production placeholder check; PUBLIC_BASE_URL is what the pages use.
SITE_HOST=bills.example.org
# HSTS in seconds; 0 disables it. Turn it on — 31536000 is a year — only once HTTPS and the domain
# are known good, because a year-long promise made before a certificate works takes the site down
# for every browser that saw it (HANDOFF 17). Set it here or in nginx, never in both.
HSTS_MAX_AGE_SECONDS=0
DATABASE_URL=postgresql+psycopg://billwatcher:CHANGE_ME@db:5432/billwatcher
POSTGRES_DB=billwatcher
POSTGRES_USER=billwatcher
POSTGRES_PASSWORD=CHANGE_ME
PUBLIC_BASE_URL=https://bills.example.org
CONTACT_EMAIL=operator@example.org
BLOB_STORAGE_ROOT=/var/lib/billwatcher/blobs
# filesystem | s3. The `s3` backend talks to the internal VersityGW service (ADR-013).
BLOB_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://blobs:7070
S3_BUCKET=billwatcher-blobs
S3_ACCESS_KEY_ID=billwatcher
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_REGION=us-east-1

# Serving our archived copy of an official document is gated on the rights review in
# assumption A14 and ADR-004. Leave false until that review concludes and is recorded in
# docs/status.md.
SERVE_ARCHIVED_DOCUMENTS=false
# Serving stored bytes in production also requires asserting that the A14 rights review has
# concluded, because ADR-013 says enabling it is a rights decision rather than a flag flip.
ARCHIVED_DOCUMENT_RIGHTS_CONFIRMED=false
SCRAPE_ENABLED=false
SCRAPE_INTERVAL_HOURS=12
SCRAPE_DELAY_SECONDS=2
SCRAPE_CONCURRENCY=1
SCRAPE_MAX_REQUESTS_PER_RUN=2000
SCRAPE_MAX_BYTES_PER_RUN=1073741824
SCRAPE_MAX_DURATION_SECONDS=3600
SCRAPE_MAX_NEW_DOCUMENTS=500
# The archive crawl (`make scrape-archive`, `make scrape-full`) reads one document per archived
# year per chamber and introduces the whole back catalogue at once, so it has its own budget.
ARCHIVE_MAX_REQUESTS_PER_RUN=400
ARCHIVE_MAX_BYTES_PER_RUN=2147483648
ARCHIVE_MAX_DURATION_SECONDS=7200
ARCHIVE_MAX_NEW_DOCUMENTS=5000
DOCUMENT_MAX_BYTES=104857600

# Upstream serves an incomplete certificate chain (see docs/upstream.md). Point this at a bundle
# containing the missing intermediate. TLS verification is always on; there is no setting that
# turns it off.
UPSTREAM_CA_BUNDLE=

# refuse | allow. The site publishes no robots.txt; `refuse` stops the crawl until that decision
# is reviewed and recorded (assumption A13).
ROBOTS_MISSING_POLICY=refuse
ABSENCE_STREAK_ALERT=3
COUNT_DROP_ABORT_FRACTION=0.30
FETCH_ATTEMPT_RETENTION_DAYS=180

# Release 3. Both features are off by default and the site is fully usable without them.
# No production embedding model has been selected yet (ADR-008): naming one here is a decision
# that must be recorded, and its dimension must match the schema width (1024).
SEMANTIC_SEARCH_ENABLED=false
EMBEDDING_PROVIDER=
EMBEDDING_MODEL_ID=
SEMANTIC_CANDIDATES=50
HYBRID_RRF_K=60
QUERY_EMBEDDING_CACHE_SIZE=256

# RAG additionally requires semantic search and a recorded provider decision (ADR-009).
RAG_ENABLED=false
RAG_PROVIDER=openai_compatible
RAG_MODEL_ID=
RAG_BASE_URL=http://vllm:8000/v1
# Optional bearer token for an authenticated OpenAI-compatible endpoint.
RAG_API_KEY=
RAG_MAX_CONTEXT_CHUNKS=8
RAG_MAX_QUESTION_CHARS=500
RAG_MIN_RETRIEVAL_SCORE=0.05
RAG_TIMEOUT_SECONDS=30
